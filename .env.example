# Supabase 配置
# Kong API Gateway 地址（通过域名或本地地址访问）
NEXT_PUBLIC_SUPABASE_URL=https://kong-tencent.wonlab.top
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 多应用区分 key（auth-sdk 用于区分调用来源的应用）
NEXT_PUBLIC_APP_KEY=

# 服务端备份功能
NEXT_PUBLIC_ENABLE_SERVER_BACKUP=true

# 注意：NEXT_PUBLIC_* 变量会在 `docker build` 时被固化进前端打包产物，
# 修改后必须重新执行 docker-compose build（或 docker build --build-arg）才会生效，
# 仅修改运行时环境变量/容器内 .env.local 不会生效。
